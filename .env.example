# AI Shield Protector - environment configuration (EXAMPLE)
# Copy this file to ".env" and fill in values. NEVER commit real secrets.

# --- General ---
NODE_ENV=development
PORT=3000

# --- Database ---
DATABASE_FILE=ai_shield.db

# --- CORS: comma-separated allowed origins. Leave empty for same-origin only. ---
CORS_ORIGINS=

# --- Request limits ---
MAX_REQUEST_BYTES=64000
MAX_URL_LENGTH=2048
MAX_MESSAGE_LENGTH=20000

# --- Privacy ---
# false = do NOT store scanned message content (recommended, data minimization)
STORE_MESSAGE_CONTENT=false
# 0 = keep history until manually deleted; >0 = purge records older than N days
HISTORY_RETENTION_DAYS=0

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60

# --- Optional AI explanation provider (server-side only) ---
# Core scanners work fully WITHOUT this. If unset, AI explanations are disabled.
AI_ENABLED=false
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=12000

# --- Optional threat-intelligence provider (strict allowlist) ---
# No live provider is wired up by default; this is a placeholder for authorized APIs.
THREAT_INTEL_ENABLED=false
THREAT_INTEL_PROVIDER=
THREAT_INTEL_API_KEY=
THREAT_INTEL_TIMEOUT_MS=8000
